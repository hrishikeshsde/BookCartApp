# Files that Linux (the Docker build, the deployment scripts, Caddy) reads must keep LF line endings, even on a Windows
# checkout with core.autocrlf=true: a script with CRLF fails with "bad interpreter", and a Dockerfile or Caddyfile with
# CRLF is easy to get subtly wrong.
*.sh                      text eol=lf
Dockerfile                text eol=lf
.dockerignore             text eol=lf
deploy/Caddyfile          text eol=lf
deploy/docker-compose.yml text eol=lf
deploy/.env.example       text eol=lf

# Windows batch files need CRLF.
*.bat                     text eol=crlf
