# bootstrap declares a peer dependency on @popperjs/core (for its JavaScript, which this app does not use: only its CSS is
# imported). A strict install would add that package to the lock file for nothing, so peers are resolved leniently.
# (Until the Angular 22 upgrade this was needed for the @ngrx/* 19 packages, which peered on Angular 19.)
# Delete this file when Bootstrap is removed (phase F6 of the frontend plan) and check that `npm ci` still works.
legacy-peer-deps=true
