# Copy to deploy/.env and fill in the blanks (deploy/deploy.sh does this for you and generates the secrets).
# deploy/.env holds secrets and is git-ignored. Never commit it, and keep a copy somewhere safe: the SQL password cannot
# be recovered from the database volume, and a changed JWT_SECRET signs everybody out.
#
# Values are used inside a connection string and by Docker Compose: do not put spaces, quotes, semicolons, equals signs or
# dollar signs in SA_PASSWORD or JWT_SECRET (letters and digits are the safe choice).

# ---- Mode -------------------------------------------------------------------------------------------------------
# HTTPS with Caddy (a real server with a domain):  COMPOSE_PROFILES=https, APP_BIND=127.0.0.1, FORWARDED_HEADERS=true
# Plain HTTP (a demo, a LAN, a test run):          COMPOSE_PROFILES=,      APP_BIND=0.0.0.0,   FORWARDED_HEADERS=false
COMPOSE_PROFILES=
APP_BIND=0.0.0.0
FORWARDED_HEADERS=false

# ---- Address ----------------------------------------------------------------------------------------------------
# HTTPS mode: the domain (DNS pointing at this server) and an e-mail address for the certificate. Both are required.
DOMAIN=
ACME_EMAIL=
# Plain HTTP mode: the port the site is published on.
APP_PORT=8080
# The public address of the site, with a trailing slash. HTTPS mode: https://<DOMAIN>/  Plain HTTP: http://localhost:<APP_PORT>/
JWT_ISSUER=http://localhost:8080/
JWT_AUDIENCE=http://localhost:8080/

# ---- Secrets ----------------------------------------------------------------------------------------------------
# SQL Server "sa" password: at least 8 characters with upper case, lower case and digits.
SA_PASSWORD=
# Token signing key, at least 32 characters.
JWT_SECRET=
# Optional: Google Gemini key for AI book summaries. Without it the endpoint answers 503.
GEMINI_API_KEY=

# ---- Optional ---------------------------------------------------------------------------------------------------
# SQL Server edition. Express is free for production (10 GB per database, about 1.4 GB of memory for data pages).
# Developer has no such limits but is licensed for development and testing only. Changing it on existing data is fine.
MSSQL_PID=Express
# The tag of the images. deploy/deploy.sh sets it to the date and the git commit; leave it alone otherwise.
BOOKCART_TAG=latest
