# Copy to deploy\.env, or just run scripts\release.bat once: it creates deploy\.env with generated secrets.
# deploy\.env holds secrets and is git-ignored. Never commit it.

# Port the site is published on (plain HTTP: put TLS in front of it for real use).
APP_PORT=8080
# Port SQL Server is published on, localhost only (used to apply migrations).
SQL_PORT=14331
# SQL Server "sa" password: at least 8 characters with upper case, lower case and digits.
SA_PASSWORD=
# Token signing key, at least 32 characters.
JWT_SECRET=
# The public address of the site, with a trailing slash.
JWT_ISSUER=http://localhost:8080/
JWT_AUDIENCE=http://localhost:8080/
# Optional: Google Gemini key for AI book summaries. Without it the endpoint answers 503.
GEMINI_API_KEY=
